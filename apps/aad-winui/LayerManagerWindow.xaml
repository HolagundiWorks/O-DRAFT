<Window
    x:Class="Aad.WinUi.LayerManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aad.WinUi"
    Title="Layer Properties Manager">
    <Grid x:Name="Root" PreviewKeyDown="OnWindowKey" Background="{ThemeResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--
          Manager template (docs/UI_STANDARDS.md): toolbar region, then the table taking the free
          space, then the footer. Row 1: layer actions + search. Row 2: layer states as one group.
        -->
        <StackPanel Background="{ThemeResource SurfaceSecondaryBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="{StaticResource PaddingToolbar}" MinHeight="{StaticResource PanelHeaderHeight}" ColumnSpacing="{StaticResource Space2}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}" VerticalAlignment="Center">
                    <Button x:Name="MergeButton" Click="OnMergeRequested" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="Merge into the side panel" ToolTipService.ToolTip="Merge into the side panel">
                        <local:DrawnIcon x:Name="MergeIcon" Kind="dock" />
                    </Button>
                    <Border Style="{StaticResource ToolStripDividerStyle}" />
                    <Button Click="OnNew" AutomationProperties.Name="New layer" ToolTipService.ToolTip="New layer" Style="{StaticResource IconButtonStyle}">
                        <local:DrawnIcon Kind="layer-new" />
                    </Button>
                    <Button Click="OnDelete" AutomationProperties.Name="Delete selected layers" ToolTipService.ToolTip="Delete layer" Style="{StaticResource IconButtonStyle}">
                        <local:DrawnIcon Kind="delete" />
                    </Button>
                    <Button Click="OnSetCurrent" AutomationProperties.Name="Make the selected layer current" ToolTipService.ToolTip="Set current" Style="{StaticResource IconButtonStyle}">
                        <local:DrawnIcon Kind="check" />
                    </Button>
                </StackPanel>
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="2"
                    Width="{StaticResource SearchFieldWidth}"
                    VerticalAlignment="Center"
                    PlaceholderText="Search for layer"
                    AutomationProperties.Name="Search for layer"
                    Style="{StaticResource DialogFieldStyle}"
                    TextChanged="OnSearch" />
            </Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="{StaticResource PaddingToolbar}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}" MinHeight="{StaticResource PanelHeaderHeight}">
                    <TextBlock Text="Layer states" Style="{StaticResource ToolbarLabelStyle}" />
                    <ComboBox x:Name="States" Width="{StaticResource LayerStateComboWidth}" VerticalAlignment="Center" PlaceholderText="Unsaved layer state" AutomationProperties.Name="Layer state" SelectionChanged="OnStatePicked" Style="{StaticResource DialogComboStyle}" />
                    <Button x:Name="RestoreStateButton" Content="Restore" VerticalAlignment="Center" Click="OnRestoreState" AutomationProperties.Name="Restore layer state" Style="{StaticResource CompactButtonStyle}" />
                    <Button x:Name="DeleteStateButton" Content="Delete" VerticalAlignment="Center" Click="OnDeleteState" AutomationProperties.Name="Delete layer state" Style="{StaticResource DestructiveActionStyle}" />
                    <Border Style="{StaticResource ToolStripDividerStyle}" />
                    <TextBox x:Name="StateName" Width="{StaticResource FieldWidth}" VerticalAlignment="Center" PlaceholderText="New state name" AutomationProperties.Name="New layer state name" Style="{StaticResource DialogFieldStyle}" />
                    <Button Content="Save state" VerticalAlignment="Center" Click="OnSaveState" AutomationProperties.Name="Save layer state" Style="{StaticResource CompactButtonStyle}" />
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="TableScroll" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Auto" Padding="{StaticResource PaddingToolbar}">
                <StackPanel>
                    <Grid x:Name="Header" MinHeight="{StaticResource ControlHeight}" />
                    <StackPanel x:Name="Rows" />
                </StackPanel>
            </ScrollViewer>
            <TextBlock
                x:Name="Empty"
                Text="No layers match the search."
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                IsHitTestVisible="False" />
        </Grid>
        <Grid Grid.Row="2" Style="{StaticResource DialogFooterStyle}" MinHeight="{StaticResource StatusBarHeight}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Summary" VerticalAlignment="Center" AutomationProperties.Name="Layer summary" />
            <TextBlock x:Name="Status" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="{StaticResource StatusMaxWidth}" AutomationProperties.Name="Layer manager status" />
        </Grid>
    </Grid>
</Window>
