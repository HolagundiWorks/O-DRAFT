<Window
    x:Class="Aad.WinUi.LayerManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aad.WinUi"
    Title="Layer Properties Manager">
    <Grid x:Name="Root" PreviewKeyDown="OnWindowKey" Background="{ThemeResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="{StaticResource PaddingPanel}" Background="{ThemeResource SurfaceSecondaryBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}" VerticalAlignment="Center" MinHeight="{StaticResource PanelHeaderHeight}">
                <Button x:Name="MergeButton" Click="OnMergeRequested" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="Merge into the side panel" ToolTipService.ToolTip="Merge into the side panel">
                    <local:DrawnIcon x:Name="MergeIcon" Kind="dock" />
                </Button>
                <Button Click="OnNew" AutomationProperties.Name="New layer" ToolTipService.ToolTip="New layer" Style="{StaticResource IconButtonStyle}">
                    <local:DrawnIcon Kind="layer-new" />
                </Button>
                <Button Click="OnDelete" AutomationProperties.Name="Delete selected layers" ToolTipService.ToolTip="Delete layer" Style="{StaticResource IconButtonStyle}">
                    <local:DrawnIcon Kind="delete" />
                </Button>
                <Button Click="OnSetCurrent" AutomationProperties.Name="Make the selected layer current" ToolTipService.ToolTip="Set current" Style="{StaticResource IconButtonStyle}">
                    <local:DrawnIcon Kind="check" />
                </Button>
                <Border Width="1" Margin="4,2" Background="{ThemeResource BorderSubtleBrush}" />
                <TextBlock Text="Layer state" VerticalAlignment="Center" Margin="0,0,4,0" Style="{StaticResource MutedCaptionStyle}" />
                <ComboBox x:Name="States" Width="{StaticResource LayerStateComboWidth}" MinHeight="{StaticResource ControlHeight}" PlaceholderText="Unsaved layer state" AutomationProperties.Name="Layer state" SelectionChanged="OnStatePicked" />
                <Button x:Name="RestoreStateButton" Content="Restore" MinHeight="{StaticResource DialogButtonHeight}" MinWidth="{StaticResource DialogActionMinWidth}" Margin="4,0,0,0" Click="OnRestoreState" AutomationProperties.Name="Restore layer state" Style="{StaticResource CompactButtonStyle}" />
                <Button x:Name="DeleteStateButton" Content="Delete" MinHeight="{StaticResource DialogButtonHeight}" MinWidth="{StaticResource DialogActionMinWidth}" Margin="4,0,0,0" Click="OnDeleteState" AutomationProperties.Name="Delete layer state" Style="{StaticResource CompactButtonStyle}" />
                <TextBox x:Name="StateName" Width="{StaticResource FieldWidth}" MinHeight="{StaticResource ControlHeight}" Margin="6,0,0,0" PlaceholderText="New state name" AutomationProperties.Name="New layer state name" Style="{StaticResource DialogFieldStyle}" />
                <Button Content="Save state" MinHeight="{StaticResource DialogButtonHeight}" MinWidth="{StaticResource DialogActionMinWidth}" Margin="4,0,0,0" Click="OnSaveState" AutomationProperties.Name="Save layer state" Style="{StaticResource CompactButtonStyle}" />
                <TextBox
                    x:Name="SearchBox"
                    Width="{StaticResource SearchFieldWidth}"
                    MinHeight="{StaticResource ControlHeight}"
                    Margin="6,0,0,0"
                    PlaceholderText="Search for layer"
                    AutomationProperties.Name="Search for layer"
                    Style="{StaticResource DialogFieldStyle}"
                    TextChanged="OnSearch" />
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="TableScroll" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Auto" Padding="0,2,4,2">
                <StackPanel>
                    <Grid x:Name="Header" MinHeight="{StaticResource ControlHeight}" />
                    <StackPanel x:Name="Rows" />
                </StackPanel>
            </ScrollViewer>
            <TextBlock
                x:Name="Empty"
                Text="No layers match the search."
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                IsHitTestVisible="False" />
        </Grid>
        <Grid Grid.Row="2" Padding="{StaticResource PaddingDialog}" ColumnSpacing="{StaticResource SpaceLg}" MinHeight="{StaticResource StatusBarHeight}" Background="{ThemeResource SurfaceSecondaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Summary" VerticalAlignment="Center" AutomationProperties.Name="Layer summary" />
            <TextBlock x:Name="Status" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" AutomationProperties.Name="Layer manager status" />
        </Grid>
    </Grid>
</Window>
