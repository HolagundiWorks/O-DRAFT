<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Compact CAD: body ~12 · section/header 13 · page title 18. Keep in sync with Density.cs. -->
    <x:Double x:Key="FontSizeCaption">11</x:Double>
    <x:Double x:Key="FontSizeBody">12</x:Double>
    <x:Double x:Key="FontSizeButton">12</x:Double>
    <x:Double x:Key="FontSizeLabel">12</x:Double>
    <x:Double x:Key="FontSizeCommand">12</x:Double>
    <x:Double x:Key="FontSizeMono">12</x:Double>
    <x:Double x:Key="FontSizeSection">13</x:Double>
    <x:Double x:Key="FontSizeHeading">13</x:Double>
    <x:Double x:Key="FontSizePageTitle">18</x:Double>
    <x:Double x:Key="FontSizeSplashTitle">18</x:Double>
    <FontFamily x:Key="FontFamilyUi">Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyMono">Consolas</FontFamily>
</ResourceDictionary>
