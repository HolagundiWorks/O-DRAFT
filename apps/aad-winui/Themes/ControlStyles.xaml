<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Compact CAD styles; tokens in ControlTokens / TypographyTokens / SpacingTokens. -->
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
        <Setter Property="MaxWidth" Value="{StaticResource IconButtonSize}" />
        <Setter Property="MaxHeight" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Padding" Value="{StaticResource PaddingNone}" />
        <Setter Property="MinWidth" Value="{StaticResource IconButtonSize}" />
        <Setter Property="MinHeight" Value="{StaticResource IconButtonSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusButton}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>
    <Style x:Key="ArchBarDividerStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource DividerThickness}" />
        <Setter Property="Height" Value="{StaticResource IconSize}" />
        <Setter Property="Background" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Padding" Value="{StaticResource PaddingNone}" />
        <Setter Property="MinWidth" Value="{StaticResource IconButtonSize}" />
        <Setter Property="MinHeight" Value="{StaticResource IconButtonSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusButton}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="ToolStripDividerStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource DividerThickness}" />
        <Setter Property="Height" Value="{StaticResource IconSize}" />
        <Setter Property="Background" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style x:Key="DialogFieldStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource PaddingControl}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusControl}" />
    </Style>
    <Style x:Key="DialogComboStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource PaddingControl}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusControl}" />
    </Style>
    <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="MutedCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="MonoCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMono}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="StatusBarStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="{StaticResource StatusBarHeight}" />
    </Style>
    <Style x:Key="SidePanelChromeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <Style x:Key="ToolStripChromeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style x:Key="PrimaryActionStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource DialogButtonHeight}" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="10,2,10,2" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusButton}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>
    <!-- Keyed compact styles — avoid implicit TargetType overrides that break MenuBar/TabView/Connect. -->
    <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusButton}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="{StaticResource DialogButtonHeight}" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="10,2,10,2" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>
    <Style x:Key="DialogSecondaryActionStyle" TargetType="Button" BasedOn="{StaticResource CompactButtonStyle}">
        <Setter Property="MinWidth" Value="72" />
    </Style>
    <Style x:Key="CompactTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource PaddingControl}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>
    <Style x:Key="CompactComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>
    <Style x:Key="CompactTabViewItemStyle" TargetType="TabViewItem">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="MinHeight" Value="{StaticResource FileTabHeight}" />
        <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style x:Key="AiChannelLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AccentBrush}" />
    </Style>
    <Style x:Key="CadChannelLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource CadChannelBrush}" />
    </Style>
    <Style x:Key="ShellMenuBarStyle" TargetType="MenuBar">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="MinHeight" Value="{StaticResource MenuBarHeight}" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="CompactMenuBarItemStyle" TargetType="MenuBarItem">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="MinHeight" Value="{StaticResource MenuItemHeight}" />
        <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style x:Key="CompactMenuFlyoutItemStyle" TargetType="MenuFlyoutItem">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="MinHeight" Value="{StaticResource MenuItemHeight}" />
        <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style x:Key="CompactMenuFlyoutSubItemStyle" TargetType="MenuFlyoutSubItem">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="MinHeight" Value="{StaticResource MenuItemHeight}" />
        <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style x:Key="StatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="PropertyRowStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="{StaticResource PropertyRowHeight}" />
    </Style>
    <Style x:Key="CompactListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="{StaticResource MenuItemHeight}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>
    <Style x:Key="CompactCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Padding" Value="4,0,0,0" />
    </Style>
    <Style x:Key="CompactRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Padding" Value="4,0,0,0" />
    </Style>
</ResourceDictionary>
