<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Compact CAD density (AutoCAD 2007-inspired targets, effective pixels).
      Source of truth alongside Density.cs — keep values in sync.
    -->
    <x:Double x:Key="MenuBarHeight">24</x:Double>
    <x:Double x:Key="MenuItemHeight">22</x:Double>
    <x:Double x:Key="FileTabHeight">28</x:Double>
    <x:Double x:Key="ArchBarHeight">28</x:Double>
    <x:Double x:Key="StatusBarHeight">22</x:Double>
    <x:Double x:Key="CommandLineHeight">22</x:Double>
    <x:Double x:Key="PropertyRowHeight">24</x:Double>
    <x:Double x:Key="PanelHeaderHeight">24</x:Double>
    <x:Double x:Key="DialogButtonHeight">26</x:Double>

    <x:Double x:Key="ControlHeight">24</x:Double>
    <x:Double x:Key="ControlHeightCompact">22</x:Double>
    <x:Double x:Key="IconButtonSize">26</x:Double>
    <x:Double x:Key="IconSize">16</x:Double>
    <x:Double x:Key="IconSizeSm">16</x:Double>
    <x:Double x:Key="IconStroke">1.5</x:Double>
    <x:Double x:Key="DividerThickness">1</x:Double>
    <x:Double x:Key="SplitterWidth">4</x:Double>
    <x:Double x:Key="SidePanelWidth">240</x:Double>
    <x:Double x:Key="CornerRadiusSm">2</x:Double>
    <x:Double x:Key="CornerRadiusMd">2</x:Double>
    <Thickness x:Key="BorderThicknessNone">0</Thickness>
    <Thickness x:Key="BorderThicknessHairline">1</Thickness>
    <CornerRadius x:Key="CornerRadiusButton">2</CornerRadius>
    <CornerRadius x:Key="CornerRadiusControl">2</CornerRadius>
    <CornerRadius x:Key="CornerRadiusChrome">2</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="CornerRadiusAskCard">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusAskPill">20</CornerRadius>
    <x:Double x:Key="AskPillHeight">40</x:Double>

    <!-- Override Fluent theme mins that fight compact CAD density. -->
    <x:Double x:Key="TextControlThemeMinHeight">24</x:Double>
    <x:Double x:Key="TextControlThemeMinWidth">64</x:Double>
    <x:Double x:Key="ComboBoxMinHeight">24</x:Double>
    <x:Double x:Key="ListViewItemMinHeight">22</x:Double>
    <Thickness x:Key="TextControlThemePadding">8,2,8,2</Thickness>
    <Thickness x:Key="ComboBoxPadding">8,2,8,2</Thickness>
    <Thickness x:Key="MenuBarItemPadding">8,0,8,0</Thickness>
    <Thickness x:Key="MenuFlyoutItemThemePadding">8,2,8,2</Thickness>
</ResourceDictionary>
