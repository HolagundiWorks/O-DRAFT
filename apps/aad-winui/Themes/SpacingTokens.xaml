<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      4 px spacing scale (docs/UI_STANDARDS.md). Keep in sync with Density.cs.
      Space1 tight · Space2 standard · Space3 group · Space4 section · Space5 major · Space6 large.
    -->
    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space5">20</x:Double>
    <x:Double x:Key="Space6">24</x:Double>
    <!-- Older names, snapped to the scale. SpaceXs (2) is only for icon strips. -->
    <x:Double x:Key="SpaceXs">2</x:Double>
    <x:Double x:Key="SpaceSm">4</x:Double>
    <x:Double x:Key="SpaceMd">8</x:Double>
    <x:Double x:Key="SpaceLg">12</x:Double>
    <x:Double x:Key="SpaceXl">12</x:Double>
    <x:Double x:Key="SpaceSection">16</x:Double>
    <x:Double x:Key="SpaceXxl">16</x:Double>

    <Thickness x:Key="PaddingNone">0</Thickness>
    <Thickness x:Key="PaddingXs">2</Thickness>
    <Thickness x:Key="PaddingSm">4</Thickness>
    <Thickness x:Key="PaddingMd">8</Thickness>
    <Thickness x:Key="PaddingLg">12</Thickness>
    <Thickness x:Key="PaddingControl">8,2</Thickness>
    <Thickness x:Key="PaddingDialog">12</Thickness>
    <Thickness x:Key="PaddingFooter">12,8,12,8</Thickness>
    <Thickness x:Key="PaddingToolbar">4,2,4,2</Thickness>
    <Thickness x:Key="PaddingButton">12,2,12,2</Thickness>
    <Thickness x:Key="PaddingPanel">8,4</Thickness>
    <Thickness x:Key="PaddingPanelTight">8,4,8,4</Thickness>
    <Thickness x:Key="PaddingCommandBar">12,4</Thickness>
    <Thickness x:Key="PaddingStatus">8,2,8,2</Thickness>
    <Thickness x:Key="PageMargin">16</Thickness>
    <Thickness x:Key="MarginLabelField">0,0,0,4</Thickness>
    <Thickness x:Key="MarginSection">0,0,0,12</Thickness>
    <Thickness x:Key="MarginGroupStart">8,0,0,0</Thickness>
    <Thickness x:Key="MarginToolbarDivider">4,2,4,2</Thickness>
    <Thickness x:Key="MarginWelcomePanel">24</Thickness>
    <Thickness x:Key="MarginRevisionHeaderIndent">18,0,0,0</Thickness>
</ResourceDictionary>
