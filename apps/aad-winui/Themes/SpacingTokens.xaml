<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aligned with Hcw.Ui SuiteStyles scale canon (4 / 8 / 12 / 16 / 20 / 24). -->
    <x:Double x:Key="SpaceXs">2</x:Double>
    <x:Double x:Key="SpaceSm">4</x:Double>
    <x:Double x:Key="SpaceMd">8</x:Double>
    <x:Double x:Key="SpaceLg">12</x:Double>
    <x:Double x:Key="SpaceXl">16</x:Double>
    <x:Double x:Key="SpaceSection">20</x:Double>
    <x:Double x:Key="SpaceXxl">24</x:Double>

    <Thickness x:Key="PaddingNone">0</Thickness>
    <Thickness x:Key="PaddingXs">2</Thickness>
    <Thickness x:Key="PaddingSm">4</Thickness>
    <Thickness x:Key="PaddingMd">8</Thickness>
    <Thickness x:Key="PaddingLg">12</Thickness>
    <Thickness x:Key="PaddingControl">16,6</Thickness>
    <Thickness x:Key="PaddingDialog">16,12</Thickness>
    <Thickness x:Key="PaddingPanel">16,12</Thickness>
    <Thickness x:Key="PaddingPanelTight">12,8,12,8</Thickness>
    <Thickness x:Key="PaddingCommandBar">16,8</Thickness>
    <Thickness x:Key="PaddingStatus">16,6,16,8</Thickness>
    <Thickness x:Key="PageMargin">24,20,24,24</Thickness>
    <Thickness x:Key="MarginLabelField">0,0,0,4</Thickness>
    <Thickness x:Key="MarginSection">0,0,0,16</Thickness>
</ResourceDictionary>
