<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Compact CAD spacing: panel 4–6 · dialog 10–12. Keep in sync with Density.cs. -->
    <x:Double x:Key="SpaceXs">2</x:Double>
    <x:Double x:Key="SpaceSm">4</x:Double>
    <x:Double x:Key="SpaceMd">6</x:Double>
    <x:Double x:Key="SpaceLg">10</x:Double>
    <x:Double x:Key="SpaceXl">12</x:Double>
    <x:Double x:Key="SpaceSection">14</x:Double>
    <x:Double x:Key="SpaceXxl">16</x:Double>

    <Thickness x:Key="PaddingNone">0</Thickness>
    <Thickness x:Key="PaddingXs">2</Thickness>
    <Thickness x:Key="PaddingSm">4</Thickness>
    <Thickness x:Key="PaddingMd">6</Thickness>
    <Thickness x:Key="PaddingLg">10</Thickness>
    <Thickness x:Key="PaddingControl">8,2</Thickness>
    <Thickness x:Key="PaddingDialog">10,10</Thickness>
    <Thickness x:Key="PaddingPanel">6,4</Thickness>
    <Thickness x:Key="PaddingPanelTight">6,4,6,4</Thickness>
    <Thickness x:Key="PaddingCommandBar">10,4</Thickness>
    <Thickness x:Key="PaddingStatus">8,2,8,2</Thickness>
    <Thickness x:Key="PageMargin">16,12,16,16</Thickness>
    <Thickness x:Key="MarginLabelField">0,0,0,2</Thickness>
    <Thickness x:Key="MarginSection">0,0,0,10</Thickness>
</ResourceDictionary>
