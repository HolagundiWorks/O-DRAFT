<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Aad.WinUi</RootNamespace>
    <AssemblyName>ODraft.WinUi</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\app-icon\aad.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Sibling O-Dynamo checkout enables in-process GraphEngine (Phase 6). -->
    <_ODraftGraphProj>$(MSBuildThisFileDirectory)..\..\..\O-Dynamo\src\ODraft\ODraft.Graph\ODraft.Graph.csproj</_ODraftGraphProj>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('$(_ODraftGraphProj)')">
    <DefineConstants>$(DefineConstants);ODRAFT_GRAPH</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(_ODraftGraphProj)')">
    <ProjectReference Include="$(_ODraftGraphProj)" />
  </ItemGroup>
  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="..\..\assets\app-icon\aad.ico" Link="aad.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\app-icon\aad-256.png" Link="aad-256.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\furniture\standard\**\*" Link="furniture\standard\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\blocks\**\*" Link="blocks\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyHost" AfterTargets="Build">
    <PropertyGroup>
      <!-- Prefer the sandbox/agent cargo target, then repo targets (newest wins via ordered Exists). -->
      <_HostCandidate0>$(LOCALAPPDATA)\Temp\odraft-cargo-target\release\aad_host.dll</_HostCandidate0>
      <_HostCandidate1>$(MSBuildThisFileDirectory)..\..\target\x86_64-pc-windows-msvc\release\aad_host.dll</_HostCandidate1>
      <_HostCandidate2>$(MSBuildThisFileDirectory)..\..\target\x86_64-pc-windows-msvc\debug\aad_host.dll</_HostCandidate2>
      <_HostCandidate3>$(MSBuildThisFileDirectory)..\..\target\release\aad_host.dll</_HostCandidate3>
      <_HostCandidate4>$(MSBuildThisFileDirectory)..\..\target\debug\aad_host.dll</_HostCandidate4>
      <_HostDll Condition="Exists('$(_HostCandidate0)')">$(_HostCandidate0)</_HostDll>
      <_HostDll Condition="'$(_HostDll)' == '' and Exists('$(_HostCandidate1)')">$(_HostCandidate1)</_HostDll>
      <_HostDll Condition="'$(_HostDll)' == '' and Exists('$(_HostCandidate2)')">$(_HostCandidate2)</_HostDll>
      <_HostDll Condition="'$(_HostDll)' == '' and Exists('$(_HostCandidate3)')">$(_HostCandidate3)</_HostDll>
      <_HostDll Condition="'$(_HostDll)' == '' and Exists('$(_HostCandidate4)')">$(_HostCandidate4)</_HostDll>
    </PropertyGroup>
    <Copy SourceFiles="$(_HostDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="false" Condition="'$(_HostDll)' != ''" />
  </Target>
</Project>
